# Copy this file to .env and fill in real values. Never commit .env.
#
# Each 1322 platform issues its own API key from your dashboard at
# https://1322.io. You only need the keys for the platform(s) you use.

# X / Twitter (Normal or Ultimate tier key)
X_API_KEY=YOUR_API_KEY_HERE

# Truth Social — REST key, plus the WS path/key shown in your dashboard config
TRUTH_API_KEY=YOUR_API_KEY_HERE
TRUTH_WS_PATH=YOUR_WS_PATH_HERE
TRUTH_WS_KEY=YOUR_WS_KEY_HERE

# Instagram (REST + WebSocket share the same key)
INSTAGRAM_API_KEY=YOUR_API_KEY_HERE

# News — REST key; ws_path/ws_key are fetched automatically from /v1/dashboard
NEWS_API_KEY=YOUR_API_KEY_HERE

# Binance Square — REST key; ws_path/ws_key are fetched automatically from /v1/dashboard
BINANCE_API_KEY=YOUR_API_KEY_HERE

# YouTube — API key plus the full WebSocket URL from your dashboard config
# (1322's public docs do not publish a fixed YouTube WS path; see README)
YOUTUBE_API_KEY=YOUR_API_KEY_HERE
YOUTUBE_WS_URL=YOUR_WS_URL_HERE
